# 🚀 OpenClaw Flow Telegram Bot 环境配置
# 将此文件复制为 .env 并填入你的配置

# ============================================
# Telegram Bot 配置
# ============================================

# Telegram Bot Token (从 @BotFather 获取)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Bot 用户名 (不带 @)
BOT_USERNAME=your_bot_username

# 管理员Chat ID (可选，用于接收系统通知)
ADMIN_CHAT_ID=123456789

# ============================================
# 服务器配置
# ============================================

# 服务器端口
PORT=3000

# 环境 (development/production)
NODE_ENV=development

# Webhook URL (生产环境需要)
WEBHOOK_URL=https://your-domain.com/webhook

# ============================================
# OpenClaw Flow 集成配置
# ============================================

# OpenClaw Flow 安装路径
OPENCLAW_FLOW_PATH=/usr/local/bin/openclaw-flow

# 备用方案：使用npm包
# OPENCLAW_FLOW_MODULE_PATH=../openclaw-flow

# ============================================
# 数据库配置
# ============================================

# Redis 连接 (用于用户状态缓存)
REDIS_URL=redis://localhost:6379

# SQLite 数据库路径
DATABASE_PATH=./data/bot.db

# ============================================
# 日志配置
# ============================================

# 日志级别 (error, warn, info, debug)
LOG_LEVEL=info

# 日志文件路径
LOG_FILE=./logs/bot.log

# ============================================
# 安全配置
# ============================================

# API 密钥 (用于webhook验证)
API_SECRET=your_api_secret_here

# 允许的用户ID列表 (逗号分隔，为空则允许所有)
ALLOWED_USER_IDS=

# 最大并发用户数
MAX_CONCURRENT_USERS=100

# ============================================
# 功能配置
# ============================================

# 是否启用工作流创建
ENABLE_WORKFLOW_CREATION=true

# 是否启用自然语言处理
ENABLE_NLP=true

# 是否启用实时通知
ENABLE_REALTIME_NOTIFICATIONS=true

# 是否启用数据分析
ENABLE_ANALYTICS=true

# ============================================
# 通知配置
# ============================================

# 工作流创建成功通知
NOTIFY_ON_WORKFLOW_CREATE=true

# 工作流执行成功通知
NOTIFY_ON_WORKFLOW_SUCCESS=true

# 工作流执行失败通知
NOTIFY_ON_WORKFLOW_FAILURE=true

# 系统状态通知
NOTIFY_ON_SYSTEM_STATUS=true

# ============================================
# 性能配置
# ============================================

# 消息处理超时 (毫秒)
MESSAGE_TIMEOUT_MS=10000

# 工作流创建超时 (毫秒)
WORKFLOW_TIMEOUT_MS=30000

# 缓存过期时间 (秒)
CACHE_EXPIRY_SECONDS=300

# ============================================
# 开发配置
# ============================================

# 是否启用调试模式
DEBUG=false

# 是否启用模拟模式 (不实际执行工作流)
SIMULATION_MODE=false

# 模拟延迟 (毫秒)
SIMULATION_DELAY_MS=1000

# ============================================
# 监控配置
# ============================================

# 是否启用健康检查
ENABLE_HEALTH_CHECK=true

# 监控端口
MONITOR_PORT=8080

# 性能指标收集
COLLECT_METRICS=true

# ============================================
# 高级配置
# ============================================

# 自定义工作流模板目录
CUSTOM_TEMPLATES_PATH=./templates

# 用户数据备份目录
USER_DATA_BACKUP_PATH=./backups

# 最大工作流数量限制
MAX_WORKFLOWS_PER_USER=20

# 每日最大创建工作流次数
DAILY_WORKFLOW_CREATION_LIMIT=10