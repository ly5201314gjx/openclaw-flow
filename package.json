{
  "name": "openclaw-flow",
  "version": "0.1.0",
  "description": "OpenClaw Flow - Your First Sentence, My Full Workflow. Turn natural language into complete OpenClaw automation.",
  "keywords": [
    "openclaw",
    "copilot",
    "workflow",
    "automation",
    "ai-agent",
    "skill-orchestration"
  ],
  "main": "index.js",
  "bin": {
    "openclaw-copilot": "./cli.js"
  },
  "scripts": {
    "start": "node cli.js",
    "test": "node test/all.js",
    "demo": "node demo/final-demo.js",
    "lint": "eslint .",
    "format": "prettier --write '**/*.js'"
  },
  "author": "乡小玉 <xiaoyu@openclaw.ai>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/openclaw/openclaw-copilot"
  },
  "bugs": {
    "url": "https://github.com/openclaw/openclaw-copilot/issues"
  },
  "homepage": "https://openclaw.ai/copilot",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "figlet": "^1.6.0",
    "inquirer": "^9.2.12",
    "ora": "^7.0.1",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "files": [
    "src/",
    "cli.js",
    "index.js",
    "README.md",
    "LICENSE"
  ],
  "openclaw": {
    "skillType": "copilot",
    "requires": [
      "openclaw>=2026.2.0",
      "binance-trading-skill",
      "telegram-channel"
    ],
    "compatibleSkills": [
      "binance-trading",
      "zhihu-hot",
      "file-storage",
      "cron",
      "telegram-message"
    ]
  }
}
